# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional Groq API key for fast inference (openai/gpt-oss-120b or qwen/qwen3-32b).
# Falls back to server-side Gemini (gemini-3.8-flash) when not configured.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# HINDSIGHT CONFIGURATION (Official @vectorize-io/hindsight-client SDK)
# Point HINDSIGHT_BASE_URL to your Hindsight server (e.g., http://localhost:8888 or https://api.hindsight.vectorize.io)
# When unset in local/preview environments, connects to the built-in Hindsight V1 OpenAPI engine at http://localhost:3000/hindsight-engine
HINDSIGHT_BASE_URL=""
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_ID="incident-memory-os-prod"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
